# =============================================================================
# Virtual Teaching Assistant (VTA) — environment template.
#
# Copy this file to `.env` and adjust as needed:
#     cp .env.example .env
#
# Conventions:
#   - All variable names are UPPER_SNAKE_CASE. This matters: the
#     EnvSecretsProvider in @vta/shared maps a logical secret name to an env var
#     by upper-casing it and turning dots/dashes into underscores
#     (e.g. `openrouter.api-key` -> OPENROUTER_API_KEY, `discord.bot-token` ->
#     DISCORD_BOT_TOKEN), then reads that env var. So any secret you expect it to
#     resolve must be defined here using that exact UPPER_SNAKE key.
#   - Values shown below are local-development defaults aligned with
#     docker-compose.yml. Do NOT commit a real `.env` with live secrets.
# =============================================================================

# ---- Core runtime -----------------------------------------------------------

# Node environment. Use "development" locally; "production" in deployed envs.
NODE_ENV=development

# Selects the active LLM profile (model routing / role mapping):
#   - "openrouter" — the DEPLOYED profile. Routes EVERY role (chat, fallback,
#                    embeddings, rerank, guard.judge, web search) through the
#                    OpenRouter gateway with a single key. Needs only
#                    OPENROUTER_API_KEY below.
#   - "dev" / "prod" — authenticate each role directly: DeepSeek (primary chat) +
#                    OpenAI (fallback chat + embeddings). Need the legacy keys in
#                    the "alternative profiles" section below.
LLM_PROFILE=openrouter

# ---- Datastores (match docker-compose.yml) ----------------------------------

# PostgreSQL connection string. Matches the postgres service:
#   user=vta password=vta db=vta host=localhost port=5432
# The database has the pgvector extension enabled (see infra/postgres/init.sql).
DATABASE_URL=postgres://vta:vta@localhost:5432/vta

# Redis connection string. Matches the redis service (used by BullMQ).
REDIS_URL=redis://localhost:6379

# ---- Secrets provider -------------------------------------------------------

# Which SecretsProvider implementation @vta/shared should construct:
#   - "env":       EnvSecretsProvider — reads secrets from process.env.
#   - "keyvault":  KeyVaultSecretsProvider — reads from Azure Key Vault.
# Local development uses "env" so secrets come from this file.
SECRETS_PROVIDER=env

# Azure Key Vault URL. Only used when SECRETS_PROVIDER=keyvault.
# Leave blank for local development (env provider).
AZURE_KEY_VAULT_URL=

# ---- Logging ----------------------------------------------------------------

# Pino log level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Optional: Azure Application Insights connection string. When set, the worker
# ships console logs, exceptions, and outbound HTTP as telemetry; when blank it
# is a no-op (nothing is loaded). Leave blank locally.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# =============================================================================
# LLM credentials
# -----------------------------------------------------------------------------
# The active LLM_PROFILE decides which of these you need.
# =============================================================================

# ---- OpenRouter (LLM_PROFILE=openrouter — the deployed default) -------------
# Single key for ALL model traffic: chat, fallback, embeddings, rerank,
# guard.judge, and `:online` web search. (secret `openrouter.api-key`)
OPENROUTER_API_KEY=

# Optional OpenRouter base URL override. Defaults to https://openrouter.ai/api/v1.
OPENROUTER_BASE_URL=

# ---- Alternative profiles (LLM_PROFILE=dev|prod only) -----------------------
# NOT used by the deployed "openrouter" profile — leave blank unless you switch
# LLM_PROFILE to "dev" or "prod", which authenticate each provider directly.

# DeepSeek API key — primary chat model in dev/prod. (secret `deepseek.api-key`)
DEEPSEEK_API_KEY=

# OpenAI API key — fallback chat + embeddings in dev/prod. (secret `openai.api-key`)
OPENAI_API_KEY=

# DeepSeek API base URL override (dev/prod only), e.g. https://api.deepseek.com
DEEPSEEK_BASE_URL=

# -----------------------------------------------------------------------------
# Per-course channel tokens (Phase 1):
#
# Per-course secrets follow the EnvSecretsProvider UPPER_SNAKE naming
# convention. Course-scoped tokens are suffixed with the upper-cased course
# identifier so each course can carry its own credentials, e.g. for a course
# whose id resolves to "CS101":
#
#   CANVAS_TOKEN_CS101=...        # Canvas LMS API token for course CS101
#
# Discord uses a single bot token for the application (the bot is invited to
# each course's guild/channel; per-course routing happens in app config rather
# than via per-course tokens):
#
#   DISCORD_BOT_TOKEN=...         # Discord bot token for the VTA application
#
# These are intentionally left undefined here — add the specific keys you need
# once Phase-1 channels are implemented.
# -----------------------------------------------------------------------------
